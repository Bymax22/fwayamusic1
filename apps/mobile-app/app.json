{
  "expo": {
    "name": "Fwaya",
    "slug": "fwaya",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "fwaya",
    "orientation": "portrait",
    "icon": "./assets/fwaya-01-01.jpg",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./withKotlinJvmTarget",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "fwaya.app",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "fwaya.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-fwaya.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "owner": "fwaya",
    "extra": {
      "eas": {
        "projectId": "80863b0a-df19-4fc3-98b9-6c0c20e0560c"
      }
    }
  }
}
