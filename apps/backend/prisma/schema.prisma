generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== COMPREHENSIVE ENUMS FOR WORLD-CLASS STREAMING ====================

enum MediaType {
  AUDIO
  VIDEO
  PODCAST
  LIVE_STREAM
  ALBUM
  COLLECTION
  PLAYLIST
}

enum VideoQuality {
  MOBILE      // 360p - 500 kbps
  SD          // 480p - 1.5 Mbps
  HD          // 720p - 3 Mbps
  FULL_HD     // 1080p - 6 Mbps
  QUAD_HD     // 1440p - 12 Mbps
  ULTRA_HD    // 2160p (4K) - 20 Mbps
  ULTRA_HD_8K // 4320p (8K) - 40 Mbps
}

enum VideoCodec {
  H264
  H265_HEVC
  VP9
  AV1
}

enum AudioCodec {
  AAC
  MP3
  OPUS
  FLAC
  ALAC
  VORBIS
}

enum PlaylistType {
  SYSTEM
  USER
  SMART
  RADIO
  COLLABORATIVE
  ALGORITHM_GENERATED
  TRENDING
  CURATED
}

enum UserRole {
  USER
  ARTIST
  ADMIN
  MODERATOR
  RESELLER
  PRODUCER
  CONTENT_MANAGER
  ANALYTICS_VIEWER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CANCELLED
}

enum MediaAccessType {
  FREE
  PREMIUM
  PAY_PER_VIEW
  SUBSCRIPTION
  TIME_LIMITED
  EXCLUSIVE
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CRYPTO
  WALLET
  OTHER
}

enum PaymentProvider {
  MTN_MONEY
  AIRTEL_MONEY
  STRIPE
  PAYPAL
  FLUTTERWAVE
  PAYSTACK
  MPESA
  BANK
  COINBASE
  CRYPTO_GATEWAY
  OTHER
}

enum Currency {
  USD
  EUR
  GBP
  ZMW
  ZAR
  KES
  NGN
  GHS
  UGX
  TZS
  XOF
  XAF
  AUD
  CAD
  JPY
  CNY
  INR
  BRL
  MXN
  BWP
  RWF
  ETB
  MUR
  SCR
}

enum SubscriptionPlan {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
  PENDING
}

enum CommissionStatus {
  PENDING
  PAID
  FAILED
  HOLD
  DISPUTED
  REFUNDED
}

enum ResellerLinkStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

enum DeviceRestrictionLevel {
  NONE
  BASIC
  STRICT
  ENCRYPTED
  ULTRA_SECURE
}

enum DownloadAccessType {
  OFFLINE
  ONLINE
  STREAMING
  BOTH
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  VERIFIED
  REJECTED
  DELETED_PENDING
  DELETED_COMPLETED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  ADDITIONAL_INFO_NEEDED
  EXPIRED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  UTILITY_BILL
  BANK_STATEMENT
  PROOF_OF_ADDRESS
}

enum VerificationMethod {
  EMAIL
  PHONE
  SMS
  DOCUMENT
  BIOMETRIC
  TWO_FACTOR_AUTH
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  DELETED
  SCHEDULED
  PRIVATE
}

enum DeletionReason {
  USER_REQUEST
  DUPLICATE
  COPYRIGHT_VIOLATION
  POLICY_VIOLATION
  ACCOUNT_DELETION
  ADMIN_REMOVAL
  EXPIRED
  OTHER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  UNDER_REVIEW
  APPEALED
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  CANCELLED
  PROCESSING
  ARCHIVED
}

enum RecommendationType {
  TRENDING
  PERSONALIZED
  COLLABORATIVE
  CONTENT_BASED
  SOCIAL
  TRENDING_LOCAL
  TRENDING_GLOBAL
  SIMILAR_ARTIST
}

enum StreamingQualityPreset {
  ADAPTIVE
  MOBILE_FIRST
  BALANCED
  HIGH_QUALITY
  DATA_SAVER
}

enum NotificationType {
  NEW_RELEASE
  FOLLOW
  LIKE
  COMMENT
  SHARE
  PURCHASE
  DOWNLOAD_COMPLETE
  STREAM_MILESTONE
  SYSTEM
  PROMOTION
  LIVE_STREAM_START
  COLLABORATION_REQUEST
}

enum AudioFeatureCategory {
  ENERGETIC
  ACOUSTIC
  DANCEABLE
  MELANCHOLIC
  UPLIFTING
  DARK
  RELAXED
  AGGRESSIVE
  INSTRUMENTAL
  VOCAL_HEAVY
}

enum CollaborationType {
  PRODUCER
  FEATURE_ARTIST
  SONGWRITER
  ENGINEER
  MIXER
  MASTERING
  BAND_MEMBER
  GUEST_ARTIST
}

enum RatingValue {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

// ==================== CORE MODELS ====================

model User {
  id                      Int              @id @default(autoincrement())
  email                   String           @unique
  username                String           @unique
  passwordHash            String           @map("password_hash")
  displayName             String?          @map("display_name")
  avatarUrl               String?          @map("avatar_url")
  cloudinaryPublicId      String?          @map("cloudinary_public_id")
  coverImageUrl           String?          @map("cover_image_url")
  coverCloudinaryId       String?          @map("cover_cloudinary_id")
  bio                     String?
  
  // Authentication & Security
  isSocialAuth            Boolean          @default(false) @map("is_social_auth")
  provider                String?
  socialId                String?          @map("social_id")
  lastLoginAt             DateTime?        @map("last_login_at")
  lastLoginIp             String?          @map("last_login_ip")
  twoFactorEnabled        Boolean          @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?          @map("two_factor_secret")
  passwordChangedAt       DateTime?        @map("password_changed_at")
  lastPasswordReset       DateTime?        @map("last_password_reset")
  
  // Account Status & Verification
  role                    UserRole         @default(USER)
  status                  UserStatus       @default(PENDING) @map("status")
  isEmailVerified         Boolean          @default(false) @map("is_email_verified")
  isPhoneVerified         Boolean          @default(false) @map("is_phone_verified")
  isAccountVerified       Boolean          @default(false) @map("is_account_verified")
  acceptedTerms           Boolean          @default(false) @map("accepted_terms")
  acceptedPrivacy         Boolean          @default(false) @map("accepted_privacy")
  acceptedCookies         Boolean          @default(false) @map("accepted_cookies")
  consentDate             DateTime?        @map("consent_date")
  
  // Subscription & Premium
  isPremium               Boolean          @default(false) @map("is_premium")
  premiumUntil            DateTime?        @map("premium_until")
  subscriptionPlan        SubscriptionPlan? @map("subscription_plan")
  autoRenewSubscription   Boolean          @default(true) @map("auto_renew_subscription")
  freeTrialUsed           Boolean          @default(false) @map("free_trial_used")
  freeTrialExpiresAt      DateTime?        @map("free_trial_expires_at")
  
  // Personal Information
  phoneNumber             String?          @map("phone_number")
  dateOfBirth             DateTime?        @map("date_of_birth")
  gender                  String?
  country                 String?          @default("US")
  address                 Json?
  timezone                String?          @default("UTC")
  language                String?          @default("en")
  
  // Artist Profile
  isArtist                Boolean          @default(false) @map("is_artist")
  artistName              String?          @map("artist_name")
  stageName               String?          @map("stage_name")
  website                 String?
  socialLinks             Json?            @map("social_links")
  artistBio               String?          @map("artist_bio")
  verifiedArtist          Boolean          @default(false) @map("verified_artist")
  verifiedArtistAt        DateTime?        @map("verified_artist_at")
  totalFollowers          Int              @default(0) @map("total_followers")
  totalFollowing          Int              @default(0) @map("total_following")
  
  // Producer Profile
  isProducer              Boolean          @default(false) @map("is_producer")
  producerName            String?          @map("producer_name")
  producerBio             String?          @map("producer_bio")
  producerWebsite         String?          @map("producer_website")
  verifiedProducer        Boolean          @default(false) @map("verified_producer")
  producerFollowers       Int              @default(0) @map("producer_followers")
  
  // Business Information
  isReseller              Boolean          @default(false) @map("is_reseller")
  businessName            String?          @map("business_name")
  businessType            String?          @map("business_type")
  taxId                   String?          @map("tax_id")
  taxNumber               String?          @map("tax_number")
  businessRegistration    String?          @map("business_registration")
  businessLicense         String?          @map("business_license")
  businessVerified        Boolean          @default(false) @map("business_verified")
  
  // Financial Data
  walletBalance           Float            @default(0) @map("wallet_balance")
  totalEarnings           Float            @default(0) @map("total_earnings")
  totalSpent              Float            @default(0) @map("total_spent")
  totalStreams            Int              @default(0) @map("total_streams")
  monthlySpend            Float            @default(0) @map("monthly_spend")
  monthlyEarnings         Float            @default(0) @map("monthly_earnings")
  
  // Commission & Reseller
  commissionRate          Float?           @default(0.2) @map("commission_rate")
  totalCommission         Float            @default(0) @map("total_commission")
  paidCommission          Float            @default(0) @map("paid_commission")
  resellerCode            String?          @unique @map("reseller_code")
  resellerEarnings        Float            @default(0) @map("reseller_earnings")
  referralCode            String?          @unique @map("referral_code")
  
  // Payment & Currency
  defaultCurrency         Currency         @default(USD) @map("default_currency")
  paymentAccounts         PaymentAccount[]
  
  // Preferences
  marketingEmails         Boolean          @default(false) @map("marketing_emails")
  dataSharing             Boolean          @default(false) @map("data_sharing")
  notificationSettings    Json?            @map("notification_settings")
  streamingQualityPref    StreamingQualityPreset @default(ADAPTIVE) @map("streaming_quality_pref")
  autoDownloadQuality     VideoQuality?    @map("auto_download_quality")
  allowExplicit           Boolean          @default(true) @map("allow_explicit")
  
  // Deletion & Account Management
  deletionRequestedAt     DateTime?        @map("deletion_requested_at")
  deletionReason          String?          @map("deletion_reason")
  deletionDetails         Json?            @map("deletion_details")
  accountDeactivatedAt    DateTime?        @map("account_deactivated_at")
  
  // Timestamps
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  
  // Relations - Media
  media                   Media[]
  albums                  Album[]
  playlists               Playlist[]
  
  // Relations - Social
  followers               Follower[]       @relation("followers")
  following               Follower[]       @relation("following")
  
  // Relations - Interactions
  interactions            MediaInteraction[]
  nowPlaying              NowPlaying?
  watchHistory            WatchHistory[]
  savedForLater           SavedForLater[]
  ratings                 MediaRating[]
  
  // Relations - Streaming
  devices                 UserDevice[]
  sessions                Session[]
  downloads               Download[]
  
  // Relations - Commerce
  transactions            Transaction[]
  commissions             Commission[]
  resellerLinks           ResellerLink[]
  subscriptions           Subscription[]
  payoutRequests          PayoutRequest[]
  
  // Relations - Content
  mediaComments           MediaComment[]
  libraries               Library[]
  deviceLicenses          DeviceLicense[]
  
  // Relations - News & Updates
  newsLikes               NewsLike[]
  newsShares              NewsShare[]
  newsComments            NewsComment[]
  newsBookmarks           NewsBookmark[]
  newsViews               NewsView[]
  newsReports             NewsReport[]
  newsReactions           NewsReaction[]
  news                    News[]
  
  // Relations - KYC & Verification
  kycSubmissions          KYCDocument[]
  verifications           Verification[]
  reviewedDocuments       KYCDocument[]   @relation("DocumentReviewer")
  auditLogs               AuditLog[]
  
  // Relations - Analytics & Recommendations
  recommendations         UserRecommendation[]
  searchHistory           SearchHistory[]
  
  // Relations - Management & Moderation
  queuedPayouts           QueuedPayout[]
  notifications           Notification[]
  contentModerations      ContentModeration[] @relation("ModerationReviewer")
  userContentModerations  ContentModeration[] @relation("ContentCreator")
  
  // Relations - Collaboration & Live
  liveStreams             LiveStream[]
  liveViewers             LiveStreamViewer[]
  collaborations          ProducerCollaboration[] @relation("CollaboratingArtist")
  collaborationRequests   ProducerCollaboration[] @relation("AssignedProducer")

  @@index([email])
  @@index([username])
  @@index([isArtist])
  @@index([isProducer])
  @@index([isReseller])
  @@index([resellerCode])
  @@index([status])
  @@index([isPremium])
  @@index([verifiedArtist])
  @@index([createdAt])
  @@map("users")
}

// ==================== MEDIA & VIDEO MODELS ====================

model Media {
  id                      Int                @id @default(autoincrement())
  title                   String
  description             String?
  url                     String             @unique
  type                    MediaType          @default(AUDIO)
  
  // Video/Audio Properties
  duration                Int?               // in seconds
  format                  String?
  fileSize                BigInt?            @map("file_size")
  bitrate                 Int?               // in kbps
  sampleRate              Int?               @map("sample_rate")
  
  // Video Specific
  width                   Int?
  height                  Int?
  videoCodec              VideoCodec?        @map("video_codec")
  videoQualityVariants    VideoVariant[]
  frameRate               Float?             @map("frame_rate")
  
  // Audio Specific
  audioCodec              AudioCodec?        @map("audio_codec")
  audioChannels           Int?               @map("audio_channels")
  
  // Artwork & Thumbnails
  artCoverUrl             String?            @map("art_cover_url")
  cloudinaryPublicId      String?            @map("cloudinary_public_id")
  thumbnailUrl            String?            @map("thumbnail_url")
  thumbnailCloudinaryId   String?            @map("thumbnail_cloudinary_id")
  
  // Classification
  genre                   String?
  tags                    String[]
  mood                    String?
  language                String?
  isExplicit              Boolean            @default(false) @map("is_explicit")
  contentStatus           ContentStatus      @default(DRAFT) @map("content_status")
  
  // Access Control
  accessType              MediaAccessType    @default(FREE) @map("access_type")
  price                   Float?             @default(0)
  
  // Audio Features & Metadata
  bpm                     Int?
  key                     String?
  energy                  Float?             // 0-1
  danceability            Float?             // 0-1
  valence                 Float?             // 0-1
  acousticness            Float?             // 0-1
  audioFeatureCategory    AudioFeatureCategory? @map("audio_feature_category")
  isrc                    String?            @map("isrc")
  
  // Metadata
  releaseDate             DateTime?          @map("release_date")
  lyricist                String?
  composer                String?
  copyrightYear           Int?               @map("copyright_year")
  copyrightOwner          String?            @map("copyright_owner")
  rights                  Json?
  
  // Ownership & Permissions
  userId                  Int?               @map("user_id")
  allowReselling          Boolean            @default(true) @map("allow_reselling")
  allowCommercialUse      Boolean            @default(true) @map("allow_commercial_use")
  allowDerivatives        Boolean            @default(true) @map("allow_derivatives")
  
  // DRM & Licensing
  isDRMProtected          Boolean            @default(false) @map("is_drm_protected")
  encryptionKey           String?            @map("encryption_key")
  maxDevices              Int                @default(1) @map("max_devices")
  licenseType             String?            @map("license_type")
  
  // Commission Rates
  artistCommissionRate    Float              @default(0.5) @map("artist_commission_rate")
  platformCommissionRate  Float              @default(0.3) @map("platform_commission_rate")
  resellerCommissionRate  Float?             @map("reseller_commission_rate")
  
  // Analytics
  playCount               Int                @default(0) @map("play_count")
  downloadCount           Int                @default(0) @map("download_count")
  shareCount              Int                @default(0) @map("share_count")
  likeCount               Int                @default(0) @map("like_count")
  lastPlayedAt            DateTime?          @map("last_played_at")
  totalStreamingTime      BigInt             @default(0) @map("total_streaming_time")
  
  // Versioning & Deletion
  version                 Int                @default(1)
  originalMediaId         Int?               @map("original_media_id")
  deletedAt               DateTime?          @map("deleted_at")
  deletionReason          DeletionReason?    @map("deletion_reason")
  deletionDetails         Json?              @map("deletion_details")
  
  // Timestamps
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  // Relations
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  album                   Album?             @relation(fields: [albumId], references: [id])
  albumId                 Int?               @map("album_id")
  
  categories              MediaCategory[]
  comments                MediaComment[]
  interactions            MediaInteraction[]
  nowPlaying              NowPlaying[]
  playlistEntries         PlaylistEntry[]
  resellerLinks           ResellerLink[]
  transactions            Transaction[]
  downloads               Download[]
  commissions             Commission[]
  deviceLicenses          DeviceLicense[]
  watchHistory            WatchHistory[]
  ratings                 MediaRating[]
  savedForLater           SavedForLater[]
  libraryItems            LibraryItem[]
  contentModerations      ContentModeration[]
  recommendations         UserRecommendation[]
  versionedMedia          Media[]            @relation("MediaVersions")
  originalMedia           Media?             @relation("MediaVersions", fields: [originalMediaId], references: [id])
  collaborators           ProducerCollaboration[]
  liveStreamSessions      LiveStreamSession[]

  @@index([userId])
  @@index([accessType])
  @@index([allowReselling])
  @@index([contentStatus])
  @@index([type])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([genre])
  @@index([playCount])
  @@map("media")
}

model VideoVariant {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  quality                 VideoQuality
  url                     String
  fileSize                BigInt             @map("file_size")
  bitrate                 Int                // in kbps
  width                   Int
  height                  Int
  codec                   VideoCodec
  createdAt               DateTime           @default(now()) @map("created_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, quality])
  @@map("video_variants")
}

model Album {
  id                      Int                @id @default(autoincrement())
  title                   String
  description             String?
  userId                  Int                @map("user_id")
  coverUrl                String?            @map("cover_url")
  cloudinaryPublicId      String?            @map("cloudinary_public_id")
  releaseDate             DateTime?          @map("release_date")
  type                    String?            // STUDIO, LIVE, COMPILATION, etc.
  recordLabel             String?            @map("record_label")
  credits                 Json?
  
  contentStatus           ContentStatus      @default(DRAFT) @map("content_status")
  isPublic                Boolean            @default(false) @map("is_public")
  
  playCount               Int                @default(0) @map("play_count")
  downloadCount           Int                @default(0) @map("download_count")
  
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                   Media[]

  @@index([userId])
  @@index([releaseDate])
  @@map("albums")
}

model MediaRating {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  userId                  Int                @map("user_id")
  rating                  RatingValue
  comment                 String?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@map("media_ratings")
}

model WatchHistory {
  id                      Int                @id @default(autoincrement())
  userId                  Int                @map("user_id")
  mediaId                 Int                @map("media_id")
  watchedAt               DateTime           @default(now()) @map("watched_at")
  watchDuration           Int?               @map("watch_duration")
  completionPercent       Float?             @map("completion_percent")
  quality                 VideoQuality?      // quality watched at
  deviceType              String?            @map("device_type")
  isOfflineWatch          Boolean            @default(false) @map("is_offline_watch")
  
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, watchedAt])
  @@index([mediaId])
  @@map("watch_history")
}

model SavedForLater {
  id                      Int                @id @default(autoincrement())
  userId                  Int                @map("user_id")
  mediaId                 Int                @map("media_id")
  savedAt                 DateTime           @default(now()) @map("saved_at")
  priority                Int                @default(0)
  notes                   String?
  
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@map("saved_for_later")
}

model MediaCategory {
  mediaId                 Int                @map("media_id")
  categoryId              Int                @map("category_id")
  assignedAt              DateTime           @default(now()) @map("assigned_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  category                Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([mediaId, categoryId])
  @@map("media_categories")
}

model Category {
  id                      Int                @id @default(autoincrement())
  name                    String             @unique
  description             String?
  slug                    String             @unique
  imageUrl                String?            @map("image_url")
  order                   Int                @default(0)
  isActive                Boolean            @default(true) @map("is_active")
  
  media                   MediaCategory[]

  @@map("categories")
}

model MediaComment {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  userId                  Int                @map("user_id")
  parentId                Int?               @map("parent_id")
  content                 String
  likes                   Int                @default(0)
  isPinned                Boolean            @default(false) @map("is_pinned")
  isEdited                Boolean            @default(false) @map("is_edited")
  editedAt                DateTime?          @map("edited_at")
  deletedAt               DateTime?          @map("deleted_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                  MediaComment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies                 MediaComment[]     @relation("CommentReplies")

  @@index([mediaId])
  @@index([userId])
  @@index([parentId])
  @@map("media_comments")
}

model MediaInteraction {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  userId                  Int?               @map("user_id")
  liked                   Boolean?           @default(false)
  saved                   Boolean?           @default(false)
  played                  Boolean?           @default(false)
  position                Int?               // for resuming playback
  lastPlayedPosition      Int?               @map("last_played_position")
  interactedAt            DateTime?          @default(now()) @map("interacted_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
  @@index([userId])
  @@map("media_interactions")
}

// ==================== PLAYLIST & ORGANIZATION ====================

model Playlist {
  id                      Int                @id @default(autoincrement())
  name                    String
  description             String?
  coverUrl                String?            @map("cover_url")
  isPublic                Boolean            @default(false) @map("is_public")
  isCollaborative         Boolean            @default(false) @map("is_collaborative")
  type                    PlaylistType       @default(USER)
