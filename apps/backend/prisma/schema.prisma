  autoRenew               Boolean            @default(false) @map("auto_renew")
  startedAt               DateTime           @default(now()) @map("started_at")
  expiresAt               DateTime           @map("expires_at")
  canceledAt              DateTime?          @map("canceled_at")
  metadata                Json?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id                      Int                @id @default(autoincrement())
  userId                  Int?               @map("user_id")
  type                    NotificationType
  title                   String
  message                 String
  data                    Json?
  isRead                  Boolean            @default(false) @map("is_read")
  readAt                  DateTime?          @map("read_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==================== NEWS & UPDATES ====================

model News {
  id                      Int                @id @default(autoincrement())
  title                   String
  slug                    String             @unique
  summary                 String?
  content                 String
  imageUrl                String?            @map("image_url")
  cloudinaryPublicId      String?            @map("cloudinary_public_id")
  authorId                Int?               @map("author_id")
  publishedAt             DateTime           @default(now()) @map("published_at")
  updatedAt               DateTime           @updatedAt
  scheduledAt             DateTime?          @map("scheduled_at")
  isPublished             Boolean            @default(true) @map("is_published")
  isFeatured              Boolean            @default(false) @map("is_featured")
  tags                    String[]
  metadata                Json?
  
  author                  User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  bookmarks               NewsBookmark[]
  comments                NewsComment[]
  likes                   NewsLike[]
  reactions               NewsReaction[]
  reports                 NewsReport[]
  shares                  NewsShare[]
  views                   NewsView[]

  @@index([authorId])
  @@index([publishedAt])
  @@index([isPublished])
  @@map("news")
}

model NewsLike {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@map("news_likes")
}

model NewsShare {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  sharedAt                DateTime           @default(now()) @map("shared_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("news_shares")
}

model NewsComment {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  content                 String
  createdAt               DateTime           @default(now()) @map("created_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("news_comments")
}

model NewsBookmark {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@map("news_bookmarks")
}

model NewsView {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int?               @map("user_id")
  viewedAt                DateTime           @default(now()) @map("viewed_at")
  ipAddress               String?            @map("ip_address")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("news_views")
}

model NewsReport {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  reason                  String
  details                 String?
  reportedAt              DateTime           @default(now()) @map("reported_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("news_reports")
}

model NewsReaction {
  id                      Int                @id @default(autoincrement())
  newsId                  Int                @map("news_id")
  userId                  Int                @map("user_id")
  type                    String             // like, love, angry, sad, wow
  reactedAt               DateTime           @default(now()) @map("reacted_at")
  
  news                    News               @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId, type])
  @@map("news_reactions")
}

// ==================== KYC & VERIFICATION ====================

model KYCDocument {
  id                      Int                @id @default(autoincrement())
  userId                  Int                @map("user_id")
  documentType            DocumentType       @map("document_type")
  documentNumber          String?            @map("document_number")
  frontImageUrl           String             @map("front_image_url")
  backImageUrl            String?            @map("back_image_url")
  selfieImageUrl          String?            @map("selfie_image_url")
  status                  KYCStatus          @default(PENDING_REVIEW) @map("status")
  rejectionReason         String?            @map("rejection_reason")
  reviewedBy              Int?               @map("reviewed_by")
  reviewedAt              DateTime?          @map("reviewed_at")
  metadata                Json?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  reviewer                User?              @relation("DocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([documentType, status])
  @@map("kyc_documents")
}

model Verification {
  id                      Int                @id @default(autoincrement())
  userId                  Int?               @map("user_id")
  method                  VerificationMethod @map("method")
  code                    String?
  token                   String?
  isVerified              Boolean            @default(false) @map("is_verified")
  expiresAt               DateTime           @map("expires_at")
  verifiedAt              DateTime?          @map("verified_at")
  metadata                Json?
  createdAt               DateTime           @default(now()) @map("created_at")
  
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@index([token, expiresAt])
  @@map("verifications")
}

// ==================== AUDITING & SECURITY ====================

model AuditLog {
  id                      Int                @id @default(autoincrement())
  userId                  Int?               @map("user_id")
  action                  String
  resource                String?
  resourceId              Int?               @map("resource_id")
  oldValues               Json?              @map("old_values")
  newValues               Json?              @map("new_values")
  ipAddress               String?            @map("ip_address")
  userAgent               String?            @map("user_agent")
  createdAt               DateTime           @default(now()) @map("created_at")
  
  user                    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemAlert {
  id                      Int                @id @default(autoincrement())
  type                    String
  message                 String
  severity                String             // LOW, MEDIUM, HIGH, CRITICAL
  resolved                Boolean            @default(false)
  resolvedAt              DateTime?          @map("resolved_at")
  resolvedBy              Int?               @map("resolved_by")
  metadata                Json?
  createdAt               DateTime           @default(now()) @map("created_at")

  @@index([type, resolved])
  @@index([severity, createdAt])
  @@map("system_alerts")
}

model SystemSettings {
  id                      Int                @id @default(autoincrement())
  key                     String             @unique
  value                   String
  description             String?
  category                String?
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

// ==================== CONTENT MODERATION ====================

model ContentModeration {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  contentCreatorId        Int                @map("content_creator_id")
  reviewerId              Int?               @map("reviewer_id")
  status                  ModerationStatus   @default(PENDING)
  reason                  String?
  flags                   String[]           // list of policy violations
  notes                   String?
  reviewedAt              DateTime?          @map("reviewed_at")
  appealed                Boolean            @default(false)
  appealReason            String?            @map("appeal_reason")
  appealedAt              DateTime?          @map("appealed_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  contentCreator          User               @relation("ContentCreator", fields: [contentCreatorId], references: [id], onDelete: Cascade)
  reviewer                User?              @relation("ModerationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mediaId])
  @@index([createdAt])
  @@map("content_moderations")
}

// ==================== CURRENCY & FLOAT ACCOUNT ====================

model CurrencyExchange {
  id                      Int                @id @default(autoincrement())
  fromCurrency            Currency           @map("from_currency")
  toCurrency              Currency           @map("to_currency")
  rate                    Float
  isActive                Boolean            @default(true) @map("is_active")
  lastUpdated             DateTime           @default(now()) @map("last_updated")

  @@unique([fromCurrency, toCurrency])
  @@map("currency_exchanges")
}

model FloatAccount {
  id                      Int                @id @default(autoincrement())
  currency                Currency           @unique
  balance                 Float              @default(0)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  transactions            FloatTransaction[]

  @@map("float_accounts")
}

model FloatTransaction {
  id                      Int                @id @default(autoincrement())
  floatAccountId          Int                @map("float_account_id")
  amount                  Float
  currency                Currency
  type                    String
  reason                  String
  balanceAfter            Float              @map("balance_after")
  reference               String?            @unique
  createdAt               DateTime           @default(now()) @map("created_at")
  
  floatAccount            FloatAccount       @relation(fields: [floatAccountId], references: [id], onDelete: Cascade)

  @@index([floatAccountId, createdAt])
  @@map("float_transactions")
}

// ==================== LIVE STREAMING ====================

model LiveStream {
  id                      Int                @id @default(autoincrement())
  title                   String
  description             String?
  userId                  Int                @map("user_id")
  status                  LiveStreamStatus   @default(SCHEDULED)
  startedAt               DateTime?          @map("started_at")
  endedAt                 DateTime?          @map("ended_at")
  scheduledFor            DateTime?          @map("scheduled_for")
  streamUrl               String?            @map("stream_url")
  streamKey               String?            @unique @map("stream_key")
  thumbnailUrl            String?            @map("thumbnail_url")
  viewerCount             Int                @default(0) @map("viewer_count")
  peakViewerCount         Int                @default(0) @map("peak_viewer_count")
  isPublic                Boolean            @default(true) @map("is_public")
  isRecorded              Boolean            @default(false) @map("is_recorded")
  recordedMediaId         Int?               @map("recorded_media_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions                LiveStreamSession[]
  viewers                 LiveStreamViewer[]

  @@index([userId, status])
  @@index([status])
  @@map("live_streams")
}

model LiveStreamSession {
  id                      Int                @id @default(autoincrement())
  liveStreamId            Int                @map("live_stream_id")
  mediaId                 Int?               @map("media_id")
  bitrate                 Int?
  fps                     Float?
  resolution              String?
  codec                   VideoCodec?
  createdAt               DateTime           @default(now()) @map("created_at")
  
  liveStream              LiveStream         @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  media                   Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@map("live_stream_sessions")
}

model LiveStreamViewer {
  id                      Int                @id @default(autoincrement())
  liveStreamId            Int                @map("live_stream_id")
  userId                  Int                @map("user_id")
  joinedAt                DateTime           @default(now()) @map("joined_at")
  leftAt                  DateTime?          @map("left_at")
  watchDuration           Int?               @map("watch_duration")
  
  liveStream              LiveStream         @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
  @@map("live_stream_viewers")
}

// ==================== PRODUCER COLLABORATION ====================

model ProducerCollaboration {
  id                      Int                @id @default(autoincrement())
  mediaId                 Int                @map("media_id")
  producerId              Int                @map("producer_id")
  artistId                Int                @map("artist_id")
  type                    CollaborationType
  roleDescription         String?            @map("role_description")
  isConfirmed             Boolean            @default(false) @map("is_confirmed")
  confirmedAt             DateTime?          @map("confirmed_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  
  media                   Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  producer                User               @relation("AssignedProducer", fields: [producerId], references: [id], onDelete: Cascade)
  artist                  User               @relation("CollaboratingArtist", fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([mediaId, producerId, type])
  @@map("producer_collaborations")
}

// ==================== SESSION MODEL (LEGACY) ====================

model sessions {
  id                      Int                @id @default(autoincrement())
  user_id                 Int?               @map("user_id")
  token                   String             @unique
  ip_address              String?            @map("ip_address")
  user_agent              String?            @map("user_agent")
  expires_at              DateTime           @map("expires_at")
  created_at              DateTime           @default(now()) @map("created_at")

  @@map("sessions_legacy")
}
